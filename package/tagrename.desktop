[Desktop Entry]
Type=Application
Name=Tag:Rename
GenericName=Music tag editor
Comment=Edit music tags and rename files in bulk
Exec=tagrename %f
Icon=tagrename
Terminal=false
Categories=AudioVideo;Audio;Music;
MimeType=inode/directory;audio/mpeg;audio/flac;audio/ogg;audio/opus;audio/mp4;audio/aac;audio/x-wav;audio/x-ms-wma;audio/x-aiff;audio/x-ape;audio/x-wavpack;audio/x-musepack;
Keywords=music;tags;rename;mp3;flac;
StartupNotify=true
StartupWMClass=tagrename
